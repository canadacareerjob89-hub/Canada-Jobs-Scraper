# Neon PostgreSQL Database Connection String (Auto-Ingestion into CRM)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-123.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google Sheets Configuration (Auto-overwrites tab with current date's data)
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here
GOOGLE_SHEET_TAB_NAME=Today_LMIA_Jobs

# Method A: Google Service Account JSON (paste base64 or raw JSON)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Method B: Google Apps Script Webhook URL (Zero-GCP Alternative)
GOOGLE_SHEET_WEBHOOK_URL=

# OpenRouter API Configuration (Optional - for Hermes AI Enrichment)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-lite:free
